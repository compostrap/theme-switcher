{
	"name": "theme-switcher-compostrap",
	"version": "1.0.3",
	"type": "module",
	"description": "Bootstrap 5 theme switcher with optional icon and label support.",
	"license": "MIT",
	"keywords": [
		"bootstrap",
		"theme",
		"dark-mode",
		"light-mode",
		"compostrap"
	],
	"exports": {
		".": "./dist/index.js",
		"./theme-switcher": "./dist/theme-switcher.js",
		"./theme-switcher.css": "./dist/theme-switcher.css",
		"./src/scss/*": "./src/scss/*",
		"./src/*": "./src/*"
	},
	"devDependencies": {
		"sass": "^1.97.1",
		"vite": "^8.0.16"
	},
	"peerDependencies": {
		"bootstrap": "^5.3.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && sass src/scss/theme-switcher.scss dist/theme-switcher.css --style=expanded --no-source-map"
	}
}
